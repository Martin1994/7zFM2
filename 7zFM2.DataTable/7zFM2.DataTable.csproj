<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<!-- Single platform-neutral TFM, for the same reason as 7zFM2: consumed by both heads. -->
		<TargetFramework>net10.0</TargetFramework>
		<UseMaui>true</UseMaui>
		<RootNamespace>SevenZip.FileManager2.Controls</RootNamespace>
		<!-- MCTEXP001: same reason as 7zFM2.csproj. -->
		<NoWarn>$(NoWarn);MCTEXP001</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" />
		<PackageReference Include="CommunityToolkit.Maui" />
	</ItemGroup>
</Project>
