<Project>
	<!--
		Minimum OS versions, per target platform.

		This deliberately lives in Directory.Build.targets rather than Directory.Build.props: the
		props file is imported *before* the project body, so $(TargetFramework) is empty there and
		every condition below would silently be false. That mistake is invisible until you look at
		the built macOS bundle, where LSMinimumSystemVersion ends up defaulting to the *SDK* version
		(27.0) and Launch Services then refuses to start the app on anything older.

		macOS: the runtime floor is 14.0, which is what the MAUI Labs AppKit backend requires. The
		heads target platform version 27 because Xcode 27 is the installed toolchain - the
		versionless net10.0-macos TFM resolves to the 26.5 SDK pack whose _ValidateXcodeVersion
		target rejects Xcode 27.
	-->
	<Choose>
		<When Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'macos'">
			<PropertyGroup>
				<SupportedOSPlatformVersion>14.0</SupportedOSPlatformVersion>
			</PropertyGroup>
		</When>
		<When Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
			<PropertyGroup>
				<SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
			</PropertyGroup>
		</When>
		<When Condition="$(TargetFramework.Contains('windows10'))">
			<PropertyGroup>
				<SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
				<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
			</PropertyGroup>
		</When>
	</Choose>
</Project>
