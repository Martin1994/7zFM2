<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SevenZip.FileManager2.FileManagerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:SevenZip.FileManager2.ViewModels"
    xmlns:controls="clr-namespace:SevenZip.FileManager2.Controls"
    xmlns:dt="clr-namespace:SevenZip.FileManager2.Controls;assembly=7zFM2.DataTable"
    x:DataType="vm:FileManagerViewModel">

    <ContentPage.Resources>
        <Style x:Key="ToolbarActionButton" TargetType="controls:ActionButton">
            <Setter Property="WidthRequest" Value="64" />
            <Setter Property="HeightRequest" Value="64" />
            <Setter Property="ShowText" Value="True" />
        </Style>
    </ContentPage.Resources>

    <ContentPage.MenuBarItems>
        <MenuBarItem Text="File">
            <!--
                TODO: keyboard accelerators (Enter, Cmd+Enter, Cmd+F4). MAUI has KeyboardAccelerator,
                but the maui-labs AppKit and GTK4 backends do not implement it yet.
            -->
            <MenuFlyoutItem Text="Open" Command="{Binding OpenCommand}" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Text="Properties" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Text="Exit" />
        </MenuBarItem>
        <MenuBarItem Text="Help">
            <MenuFlyoutItem Text="About..." />
        </MenuBarItem>
    </ContentPage.MenuBarItems>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto,Auto" RowSpacing="0">

        <BoxView Grid.Row="0" Style="{StaticResource SectionDivider}" />

        <HorizontalStackLayout Grid.Row="1" Padding="4" Spacing="4">
            <controls:ActionButton Style="{StaticResource ToolbarActionButton}" Text="Add" IsEnabled="False"
                                   Source="{AppThemeBinding Light=toolbar_add_light.png, Dark=toolbar_add_dark.png}" />
            <controls:ActionButton Style="{StaticResource ToolbarActionButton}" Text="Extract" IsEnabled="False"
                                   Source="{AppThemeBinding Light=toolbar_extract_light.png, Dark=toolbar_extract_dark.png}" />
            <controls:ActionButton Style="{StaticResource ToolbarActionButton}" Text="Test" Command="{Binding TestCommand}"
                                   Source="{AppThemeBinding Light=toolbar_test_light.png, Dark=toolbar_test_dark.png}" />
            <controls:ActionButton Style="{StaticResource ToolbarActionButton}" Text="Copy" IsEnabled="False"
                                   Source="{AppThemeBinding Light=toolbar_copy_light.png, Dark=toolbar_copy_dark.png}" />
            <controls:ActionButton Style="{StaticResource ToolbarActionButton}" Text="Move" IsEnabled="False"
                                   Source="{AppThemeBinding Light=toolbar_move_light.png, Dark=toolbar_move_dark.png}" />
            <controls:ActionButton Style="{StaticResource ToolbarActionButton}" Text="Delete" IsEnabled="False"
                                   Source="{AppThemeBinding Light=toolbar_delete_light.png, Dark=toolbar_delete_dark.png}" />
            <controls:ActionButton Style="{StaticResource ToolbarActionButton}" Text="Info" IsEnabled="False"
                                   Source="{AppThemeBinding Light=toolbar_info_light.png, Dark=toolbar_info_dark.png}" />
        </HorizontalStackLayout>

        <BoxView Grid.Row="2" Style="{StaticResource SectionDivider}" />

        <!-- Path bar -->
        <Grid Grid.Row="3" Padding="4" ColumnDefinitions="Auto,*">
            <controls:ActionButton Grid.Column="0" Text="Up one level" Command="{Binding ReturnCommand}"
                                   WidthRequest="36" HeightRequest="36"
                                   Source="{AppThemeBinding Light=address_up_light.png, Dark=address_up_dark.png}" />
            <Entry x:Name="PathEntry"
                   Grid.Column="1"
                   Margin="4,0"
                   FontSize="13"
                   IsReadOnly="True"
                   Text="{Binding Name, Mode=OneWay}" />
        </Grid>

        <BoxView Grid.Row="4" Style="{StaticResource SectionDivider}" />

        <!-- Selection mode is currently Single since the default Multiple mode doesn't fit the need
        of a file table. -->
        <dt:DataTable
            x:Name="FileList"
            Grid.Row="5"
            BackgroundColor="{AppThemeBinding Light=White, Dark=#191919}"
            ItemsSource="{Binding Items}"
            SelectedItem="{Binding SelectedItem, Mode=OneWayToSource}"
            SelectionMode="Single"
            SelectionChanged="OnSelectionChanged">
            <dt:DataTable.Resources>
                <Style x:Key="FileCellLabel" TargetType="Label">
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="Padding" Value="8,0,12,0" />
                    <!-- AppKit ignores VerticalTextAlignment; center the single-line view as well. -->
                    <Setter Property="VerticalOptions" Value="Center" />
                    <Setter Property="VerticalTextAlignment" Value="Center" />
                    <Setter Property="LineBreakMode" Value="TailTruncation" />
                    <Setter Property="MaxLines" Value="1" />
                    <Setter Property="InputTransparent" Value="True" />
                    <Setter Property="TextColor"
                            Value="{AppThemeBinding Light=#202020, Dark=#EEEEEE}" />
                </Style>
            </dt:DataTable.Resources>

            <dt:DataTable.Columns>
                <!-- Each template binds to the row item, not the page's FileManagerViewModel. -->
                <dt:DataTableColumn Header="Name" Width="300" MinWidth="120">
                    <dt:DataTableColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:IItemViewModel">
                            <Grid ColumnDefinitions="16,*" ColumnSpacing="6" Padding="8,0,0,0"
                                  InputTransparent="True">
                                <controls:FileIconView Icon="{Binding Icon}" />
                                <Label Grid.Column="1" Style="{StaticResource FileCellLabel}"
                                       Padding="0,0,12,0" Text="{Binding Name}" />
                            </Grid>
                        </DataTemplate>
                    </dt:DataTableColumn.CellTemplate>
                </dt:DataTableColumn>

                <dt:DataTableColumn Header="Size" Width="110" MinWidth="70" TextAlignment="End">
                    <dt:DataTableColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:IItemViewModel">
                            <Label Style="{StaticResource FileCellLabel}"
                                   HorizontalTextAlignment="End"
                                   Text="{Binding Size}" />
                        </DataTemplate>
                    </dt:DataTableColumn.CellTemplate>
                </dt:DataTableColumn>

                <dt:DataTableColumn Header="Modified" Width="180" MinWidth="100">
                    <dt:DataTableColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:IItemViewModel">
                            <Label Style="{StaticResource FileCellLabel}" Text="{Binding Modified}" />
                        </DataTemplate>
                    </dt:DataTableColumn.CellTemplate>
                </dt:DataTableColumn>

                <dt:DataTableColumn Header="Created" Width="180" MinWidth="100">
                    <dt:DataTableColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:IItemViewModel">
                            <Label Style="{StaticResource FileCellLabel}" Text="{Binding Created}" />
                        </DataTemplate>
                    </dt:DataTableColumn.CellTemplate>
                </dt:DataTableColumn>

                <dt:DataTableColumn Header="Comment" Width="220" MinWidth="80">
                    <dt:DataTableColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:IItemViewModel">
                            <Label Style="{StaticResource FileCellLabel}" Text="{Binding Comment}" />
                        </DataTemplate>
                    </dt:DataTableColumn.CellTemplate>
                </dt:DataTableColumn>

                <dt:DataTableColumn Header="Folders" Width="90" MinWidth="60" TextAlignment="End">
                    <dt:DataTableColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:IItemViewModel">
                            <Label Style="{StaticResource FileCellLabel}"
                                   HorizontalTextAlignment="End"
                                   Text="{Binding Folders}" />
                        </DataTemplate>
                    </dt:DataTableColumn.CellTemplate>
                </dt:DataTableColumn>

                <dt:DataTableColumn Header="Files" Width="90" MinWidth="60" TextAlignment="End">
                    <dt:DataTableColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:IItemViewModel">
                            <Label Style="{StaticResource FileCellLabel}"
                                   HorizontalTextAlignment="End"
                                   Text="{Binding Files}" />
                        </DataTemplate>
                    </dt:DataTableColumn.CellTemplate>
                </dt:DataTableColumn>
            </dt:DataTable.Columns>
        </dt:DataTable>

        <BoxView Grid.Row="6" Style="{StaticResource SectionDivider}" />

        <controls:StatusBar Grid.Row="7" Padding="20,5">
            <Label Text="{Binding SelectionStatus}" VerticalTextAlignment="Center" />
        </controls:StatusBar>
    </Grid>
</ContentPage>
