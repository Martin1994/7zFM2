<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    x:Class="SevenZip.FileManager2.AppResources"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:formats="clr-namespace:SevenZip.FileManager2.Formats">

    <formats:ByteSizeConverter x:Key="ByteSize" />

    <Style x:Key="SectionDivider" TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="InputTransparent" Value="True" />
        <Setter Property="Color" Value="{AppThemeBinding Light=#0F000000, Dark=#15FFFFFF}" />
    </Style>

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Styles/TextBlock.xaml" />
    </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>
