<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<!--
			Deliberately a single, platform-neutral TFM.

			This is the shared UI library. It is consumed by the macOS AppKit head
			(net10.0-macos27) and the Linux GTK4 head (plain net10.0). A net10.0 project cannot
			reference a platform-specific project, so platform-specific implementation lives in
			the heads and is supplied through DI - never through a project reference.

			Consequence: MACOS / WINDOWS / LINUX are all undefined here. Do not #if on them in this
			project; both branches would be compiled away silently.
		-->
		<TargetFramework>net10.0</TargetFramework>
		<UseMaui>true</UseMaui>
		<RootNamespace>SevenZip.FileManager2</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" />
		<PackageReference Include="CommunityToolkit.Mvvm" />
		<PackageReference Include="NaturalStringExtensions" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\SevenZipSharp\SevenZipSharp.csproj" />
		<ProjectReference Include="..\7zFM2.DataTable\7zFM2.DataTable.csproj" />
	</ItemGroup>
</Project>
