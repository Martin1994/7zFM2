<configuration>
    <packageSources>
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
        <!-- The maui-labs backends (Microsoft.Maui.Platforms.MacOS / .Linux.Gtk4) are pre-release
             only, and the dnceng dotnet10 feed carries versions ahead of nuget.org. -->
        <add key="dotnet10" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet10/nuget/v3/index.json" />
    </packageSources>
</configuration>
