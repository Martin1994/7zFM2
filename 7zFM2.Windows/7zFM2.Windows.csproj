<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
		<RootNamespace>SevenZip.FileManager2.Windows</RootNamespace>

		<!--
			win-* rather than the Uno-era win10-* RIDs: the versioned forms belong to the RID graph,
			which is opt-in again since .NET 8.
		-->
		<Platforms>x86;x64;arm64</Platforms>
		<RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
		<PublishProfile>win-$(Platform).pubxml</PublishProfile>

		<!--
			WindowsAppSDKSelfContained (which MAUI turns on for unpackaged apps) unpacks a
			per-architecture Windows App SDK payload, so it needs a real architecture. A bare
			`dotnet build`/`dotnet run` leaves Platform at AnyCPU with an empty
			RuntimeIdentifier, and WindowsAppSDK's GetWindowsAppSDKNativePlatform target then
			fails the build with "WindowsAppSDKSelfContained requires a supported Windows
			architecture". Mirror the solution's Any CPU -> x64 mapping so the CLI workflow
			works; an explicit Platform (VS, -p:Platform=..., a solution configuration) wins.
		-->
		<Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>

		<!--
			SDK 10.0.102 pins the Windows SDK projection at 10.0.19041.57, which bundles
			CsWinRT 2.2.0. Its AOT source generator builds the vtable-classes namespace from
			the *assembly* name and, for an assembly name starting with a digit, emits
			`namespace WinRT.7zFM2_WindowsVtableClasses` - `7zFM2_Windows` is not a valid C#
			identifier, so the generated *.WinRTVtable.g.cs files fail to compile
			(CS0118/CS0103/CS1729). RootNamespace does not help here; the generator only reads
			AssemblyName. CsWinRT fixed the escaping in 2.3.0 (microsoft/CsWinRT#2013) by
			prefixing an underscore, and 10.0.19041.87 is the first projection revision that
			carries it: it generates `WinRT._7zFM2_WindowsVtableClasses`. This keeps the
			assembly name 7zFM2.Windows, and therefore 7zFM2.Windows.exe, unchanged.
		-->
		<WindowsSdkPackageVersion>10.0.19041.87</WindowsSdkPackageVersion>

		<ApplicationManifest>app.manifest</ApplicationManifest>
		<UseWinUI>true</UseWinUI>
		<EnableMsixTooling>true</EnableMsixTooling>

		<UseMaui>true</UseMaui>
		<!--
			App.xaml in this head is WinUI XAML, not .NET MAUI XAML. Without this, MAUI's default
			item globs claim the same file and it gets compiled twice. Same setting as dotnet/maui's
			maui-multiproject template.
		-->
		<EnableDefaultMauiItems>false</EnableDefaultMauiItems>

		<!--
			Unpackaged, which is the .NET 10 MAUI default.

			It is the friction-free option: no MSIX deployment and no developer certificate, and
			MAUI then sets WindowsAppSDKSelfContained=true itself (Microsoft.Maui.Sdk.Windows.targets),
			so the Windows App SDK runtime does not have to be installed separately either. Plain
			`dotnet run -f net10.0-windows10.0.19041.0` works.

			Delete this line to go packaged: MAUI then defaults WindowsPackageType to MSIX whenever
			EnableMsixTooling is true and OutputType is WinExe, and Package.appxmanifest takes over
			(it is kept in the repo for exactly that).
		-->
		<WindowsPackageType>None</WindowsPackageType>

		<!--
			Note what is deliberately *absent*:

			* No Microsoft.WindowsAppSDK / Microsoft.Windows.SDK.BuildTools pin. MAUI 10 supplies
			  both transitively; the shipped `dotnet new maui` template from this SDK band pins no
			  version here either. The Uno head needed them because Uno.WinUI targets an older
			  Windows App SDK.
			* No TargetPlatformMinVersion. It is set per-TFM in Directory.Build.targets, because
			  Directory.Build.props is imported before $(TargetFramework) exists.
			* No Microsoft.Maui.Controls version. It comes from Directory.Packages.props via central
			  package management, as in every other project here.
		-->
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\7zFM2\7zFM2.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Manifest Include="$(ApplicationManifest)" />
	</ItemGroup>

	<!--
		Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging Tools
		extension to be activated for this project even if the Windows App SDK NuGet package has
		not yet been restored.
	-->
	<ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
		<ProjectCapability Include="Msix" />
	</ItemGroup>

	<!--
		Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
		Explorer "Package and Publish" context menu entry to be enabled for this project even if
		the Windows App SDK NuGet package has not yet been restored.
	-->
	<PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
		<HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
	</PropertyGroup>

</Project>
