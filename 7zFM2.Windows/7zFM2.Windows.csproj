<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
        <RootNamespace>SevenZip.FileManager2.Windows</RootNamespace>

        <Platforms>x86;x64;arm64</Platforms>
        <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
        <PublishProfile>win-$(Platform).pubxml</PublishProfile>

        <!--
            WindowsAppSDKSelfContained (which MAUI turns on for unpackaged apps) unpacks a
            per-architecture Windows App SDK payload, so it needs a real architecture, instead
            of the default AnyCPU.
        -->
        <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>

        <WindowsSdkPackageVersion>10.0.26100.87</WindowsSdkPackageVersion>

        <ApplicationManifest>app.manifest</ApplicationManifest>
        <UseWinUI>true</UseWinUI>
        <EnableMsixTooling>true</EnableMsixTooling>

        <UseMaui>true</UseMaui>
        <!--
            App.xaml in this head is WinUI XAML, not .NET MAUI XAML. Without this, MAUI's default
            item globs claim the same file and it gets compiled twice. Same setting as dotnet/maui's
            maui-multiproject template.
        -->
        <EnableDefaultMauiItems>false</EnableDefaultMauiItems>

        <WindowsPackageType>None</WindowsPackageType>

        <!--
            MCT001 is an error that enforces the project to register MAUI community toolkit. However,
            this project only uses the toolkit for code generation, which is not a runtime dependency.
        -->
        <NoWarn>$(NoWarn);MCT001</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\7zFM2\7zFM2.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Manifest Include="$(ApplicationManifest)" />
    </ItemGroup>

    <!--
        Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging Tools
        extension to be activated for this project even if the Windows App SDK NuGet package has
        not yet been restored.
    -->
    <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
        <ProjectCapability Include="Msix" />
    </ItemGroup>

    <!--
        Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
        Explorer "Package and Publish" context menu entry to be enabled for this project even if
        the Windows App SDK NuGet package has not yet been restored.
    -->
    <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
        <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
    </PropertyGroup>

</Project>
