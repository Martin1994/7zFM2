<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <!--
            There is no official net10.0-linux TFM, so the GTK4 backend is consumed from a plain
            net10.0 head project that references the shared library. Unlike the macOS head this
            needs no workload: Microsoft.Maui.Platforms.Linux.Gtk4 pulls Microsoft.Maui.Controls in
            transitively.
        -->
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <RootNamespace>SevenZip.FileManager2.Linux</RootNamespace>

        <ApplicationTitle>7zFM2</ApplicationTitle>
        <ApplicationId>SevenZip.FileManager2</ApplicationId>
        <UseMaui>true</UseMaui>
    </PropertyGroup>

    <ItemGroup>
        <!-- MAUI Labs GTK4 backend. Pre-release, not covered by the MAUI support policy. -->
        <PackageReference Include="Microsoft.Maui.Platforms.Linux.Gtk4" />
        <PackageReference Include="Microsoft.Maui.Platforms.Linux.Gtk4.Essentials" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\7zFM2\7zFM2.csproj" />
    </ItemGroup>

    <Import Project="../build/AppIcons.items.props" />

    <!-- Static PNGs work on every GTK host; the backend registers the 512px hicolor icon. -->
    <ItemGroup>
        <MauiImage Include="@(CustomImagePng)" Resize="False" />
        <MauiIcon Include="$(AppIconsDirectory)appicon-gtk.png" />
        <Content Include="@(CustomImageNotice)" Link="ThirdPartyNotices/%(Filename)%(Extension)"
                 TargetPath="ThirdPartyNotices/%(Filename)%(Extension)"
                 CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
</Project>
