<Project ToolsVersion="15.0">
  <ItemGroup>
    <!--
      MAUI itself.

      Pinned to a literal rather than $(MauiVersion): Directory.Packages.props is evaluated
      before the MAUI SDK props are imported, so $(MauiVersion) is empty at this point. Note that
      Microsoft.Maui.Sdk reports MauiVersion=10.0.20 while the newest published 10.x *package* is
      10.0.110 - they are different version streams, so the literal must come from nuget.org.
    -->
    <PackageVersion Include="Microsoft.Maui.Controls" Version="10.0.110" />

    <!--
      MAUI Labs backends. Pre-release only, and NOT covered by the .NET MAUI support policy.
      These live on the dnceng dotnet10 feed (see NuGet.Config), which is ahead of nuget.org.
    -->
    <PackageVersion Include="Microsoft.Maui.Platforms.MacOS" Version="0.1.0-preview.12.26474.1" />
    <PackageVersion Include="Microsoft.Maui.Platforms.MacOS.Essentials" Version="0.1.0-preview.12.26474.1" />
    <PackageVersion Include="Microsoft.Maui.Platforms.Linux.Gtk4" Version="0.1.0-preview.12.26474.1" />
    <PackageVersion Include="Microsoft.Maui.Platforms.Linux.Gtk4.Essentials" Version="0.1.0-preview.12.26474.1" />

    <!-- Windows-only HICON to PNG conversion; never referenced by GTK or AppKit. -->
    <PackageVersion Include="System.Drawing.Common" Version="10.0.13" />

    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.0" />

    <PackageVersion Include="CommunityToolkit.Maui" Version="15.0.1" />

    <PackageVersion Include="NaturalStringExtensions" Version="3.0.0" />
  </ItemGroup>
</Project>
